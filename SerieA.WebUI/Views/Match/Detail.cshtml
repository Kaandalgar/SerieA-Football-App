@model SerieA.WebUI.ViewModels.MatchDetailViewModel

@{
    ViewData["Title"] = $"{Model.HomeTeam?.Name} {Model.HomeScore}-{Model.AwayScore} {Model.AwayTeam?.Name}";


    var tr = new System.Globalization.CultureInfo("tr-TR");

    var goals = Model.Goals
        .OrderBy(x => x.Minute)
        .ToList();

    var cards = Model.Cards
        .OrderBy(x => x.Minute)
        .ToList();

    var substitutions = Model.Substitutions
        .OrderBy(x => x.Minute)
        .ToList();

    var homeGoals = goals.Where(x => x.TeamId == Model.HomeTeam?.Id).ToList();
    var awayGoals = goals.Where(x => x.TeamId == Model.AwayTeam?.Id).ToList();

    int firstHalfHome = homeGoals.Count(x => x.Minute <= 45);
    int firstHalfAway = awayGoals.Count(x => x.Minute <= 45);

    int secondHalfHome = homeGoals.Count(x => x.Minute > 45);
    int secondHalfAway = awayGoals.Count(x => x.Minute > 45);

    bool homeWinner =
        Model.HomeScore.HasValue &&
        Model.AwayScore.HasValue &&
        Model.HomeScore > Model.AwayScore;

    bool awayWinner =
        Model.HomeScore.HasValue &&
        Model.AwayScore.HasValue &&
        Model.AwayScore > Model.HomeScore;

    var allEvents = new List<(int Minute, string Type, int TeamId, string Player, string Extra, string CardType)>();

    foreach (var g in goals)
    {
        allEvents.Add((g.Minute, "goal", g.TeamId, g.PlayerName, "Gol", ""));
    }

    foreach (var c in cards)
    {
        allEvents.Add((c.Minute, "card", c.TeamId, c.PlayerName, c.CardType, c.CardType));
    }

    foreach (var s in substitutions)
    {
        allEvents.Add((s.Minute, "sub", s.TeamId, s.PlayerIn, s.PlayerOut, ""));
    }

    allEvents = allEvents
        .OrderBy(x => x.Minute)
        .ThenBy(x => x.Type)
        .ToList();

    string ShortName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "---";

        return name.Length >= 3
            ? name.Substring(0, 3).ToUpperInvariant()
            : name.ToUpperInvariant();
    }

    string StatusText(string status)
    {
        return status switch
        {
            "Finished" => "Maç bitti",
            "Live" => "Canlı",
            "Postponed" => "Ertelendi",
            _ => "Başlamadı"
        };
    }

    string ResultNote()
    {
        if (!Model.HomeScore.HasValue || !Model.AwayScore.HasValue)
            return "Sonuç yok";

        if (Model.HomeScore > Model.AwayScore)
            return $"{Model.HomeTeam?.Name} kazandı";

        if (Model.AwayScore > Model.HomeScore)
            return $"{Model.AwayTeam?.Name} kazandı";

        return "Berabere";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/match-detail.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
}

<div class="match-page">

    <!-- Tekrar kullanılan ikonlar -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="i-ball" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" fill="currentColor" />
            <path d="M12 3v4.4M20.5 9.3l-5.1.6M17.4 19.4l-3.3-5.5M6.6 19.4l3.3-5.5M3.5 9.3l5.1.6"
                  fill="none" stroke="currentColor" stroke-width="1.4" />
        </symbol>

        <symbol id="i-swap" viewBox="0 0 24 24">
            <path d="M7 4v14M3.5 7.5L7 4l3.5 3.5M17 20V6M13.5 16.5L17 20l3.5-3.5"
                  fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" />
        </symbol>

        <symbol id="i-calendar" viewBox="0 0 24 24">
            <rect x="3.5" y="5" width="17" height="15" rx="2.5"
                  fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M3.5 10h17M8 3v4M16 3v4"
                  fill="none" stroke="currentColor" stroke-width="1.8"
                  stroke-linecap="round" />
        </symbol>

        <symbol id="i-clock" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8.5"
                    fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 7.5V12l3 2"
                  fill="none" stroke="currentColor" stroke-width="1.8"
                  stroke-linecap="round" />
        </symbol>

        <symbol id="i-stadium" viewBox="0 0 24 24">
            <ellipse cx="12" cy="9" rx="9" ry="3.5"
                     fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9"
                  fill="none" stroke="currentColor" stroke-width="1.8" />
        </symbol>
    </svg>

    <main class="match-shell container-xl" data-match>

        <!-- HERO -->
        <header class="match-hero">

            <div class="hero-topbar">

                <ul class="comp-tags" aria-label="Müsabaka">
                    <li class="comp-tag comp-tag--league">Serie A</li>
                    <li class="comp-tag">2026/27</li>
                    <li class="comp-tag">Hafta @Model.Week</li>
                </ul>

                <span class="status-pill">
                    @StatusText(Model.Status)
                </span>

            </div>

            <div class="scoreboard">

                <!-- Ev sahibi -->
                <div class="sb-team sb-team--home @(awayWinner ? "is-loser" : "")">

                    @if (!string.IsNullOrWhiteSpace(Model.HomeTeam?.LogoUrl))
                    {
                        <img class="team-crest team-crest--xl"
                             src="@Url.Content(Model.HomeTeam.LogoUrl)"
                             alt="@Model.HomeTeam.Name" />
                    }
                    else
                    {
                        <span class="team-crest team-crest--xl"
                              style="--crest-a:#2E7BFF;--crest-b:#101418;--crest-ink:#fff">
                            @ShortName(Model.HomeTeam?.Name)
                        </span>
                    }

                    <div>
                        <span class="sb-team__role">Ev sahibi</span>

                        <h1 class="sb-team__name">
                            @Model.HomeTeam?.Name
                        </h1>

                        <ul class="sb-scorers"
                            aria-label="@Model.HomeTeam?.Name golleri">

                            @foreach (var goal in homeGoals)
                            {
                                <li>
                                    <svg class="i-ball" aria-hidden="true">
                                        <use href="#i-ball" />
                                    </svg>
                                    @goal.PlayerName @goal.Minute'
                                </li>
                            }

                        </ul>
                    </div>
                </div>

                <!-- Skor -->
                <div class="sb-score">

                    <p class="sb-score__value"
                       aria-label="Skor">

                        <span class="@(awayWinner ? "is-loser" : "")">
                            @(Model.HomeScore?.ToString() ?? "-")
                        </span>

                        <span class="sb-score__sep" aria-hidden="true"></span>

                        <span class="@(homeWinner ? "is-loser" : "")">
                            @(Model.AwayScore?.ToString() ?? "-")
                        </span>

                    </p>

                    <p class="sb-score__ht">
                        İlk yarı @firstHalfHome-@firstHalfAway
                    </p>

                </div>

                <!-- Deplasman -->
                <div class="sb-team sb-team--away @(homeWinner ? "is-loser" : "")">

                    @if (!string.IsNullOrWhiteSpace(Model.AwayTeam?.LogoUrl))
                    {
                        <img class="team-crest team-crest--xl"
                             src="@Url.Content(Model.AwayTeam.LogoUrl)"
                             alt="@Model.AwayTeam.Name" />
                    }
                    else
                    {
                        <span class="team-crest team-crest--xl"
                              style="--crest-a:#A9BCDF;--crest-b:#101418;--crest-ink:#fff">
                            @ShortName(Model.AwayTeam?.Name)
                        </span>
                    }

                    <div>
                        <span class="sb-team__role">Deplasman</span>

                        <h2 class="sb-team__name">
                            @Model.AwayTeam?.Name
                        </h2>

                        <ul class="sb-scorers"
                            aria-label="@Model.AwayTeam?.Name golleri">

                            @foreach (var goal in awayGoals)
                            {
                                <li>
                                    <svg class="i-ball" aria-hidden="true">
                                        <use href="#i-ball" />
                                    </svg>
                                    @goal.PlayerName @goal.Minute'
                                </li>
                            }

                        </ul>
                    </div>
                </div>

            </div>

            <!-- Maç bilgileri -->
            <ul class="hero-facts">

                <li>
                    <svg aria-hidden="true">
                        <use href="#i-calendar" />
                    </svg>
                    @Model.MatchDate.ToString("d MMMM yyyy", tr)
                </li>

                <li>
                    <svg aria-hidden="true">
                        <use href="#i-clock" />
                    </svg>
                    @Model.MatchDate.ToString("HH:mm")
                </li>

                <li>
                    <svg aria-hidden="true">
                        <use href="#i-stadium" />
                    </svg>
                    @Model.Stadium
                </li>

            </ul>

            <!-- MAÇ AKIŞI -->
            <section class="flow-strip"
                     aria-labelledby="flow-title">

                <div class="flow-head">
                    <h2 class="flow-title"
                        id="flow-title">
                        Maç akışı
                    </h2>

                    <p class="flow-hint">
                        Ayrıntısını görmek için bir olaya dokun
                    </p>
                </div>

                <div class="flow-scroll">

                    <div class="flow-track">

                        <span class="flow-side-label flow-side-label--home">
                            @if (!string.IsNullOrWhiteSpace(Model.HomeTeam?.LogoUrl))
                            {
                                <img class="team-crest team-crest--xs"
                                     src="@Url.Content(Model.HomeTeam.LogoUrl)"
                                     alt="" />
                            }
                        </span>

                        <span class="flow-side-label flow-side-label--away">
                            @if (!string.IsNullOrWhiteSpace(Model.AwayTeam?.LogoUrl))
                            {
                                <img class="team-crest team-crest--xs"
                                     src="@Url.Content(Model.AwayTeam.LogoUrl)"
                                     alt="" />
                            }
                        </span>

                        <span class="flow-axis" aria-hidden="true"></span>

                        <span class="flow-half" aria-hidden="true">
                            <span>Devre arası</span>
                        </span>

                        <span class="flow-tick" style="--x:calc(15 / 95 * 100%)">15'</span>
                        <span class="flow-tick" style="--x:calc(30 / 95 * 100%)">30'</span>
                        <span class="flow-tick" style="--x:calc(45 / 95 * 100%)">45'</span>
                        <span class="flow-tick" style="--x:calc(60 / 95 * 100%)">60'</span>
                        <span class="flow-tick" style="--x:calc(75 / 95 * 100%)">75'</span>
                        <span class="flow-tick" style="--x:calc(90 / 95 * 100%)">90'</span>

                        @foreach (var e in allEvents)
                        {
                            var side = e.TeamId == Model.HomeTeam?.Id ? "home" : "away";
                            var id = $"ev-{e.Type}-{e.Minute}-{e.TeamId}";

                            if (e.Type == "goal")
                            {
                                <button type="button"
                                        class="flow-marker flow-marker--@side flow-marker--goal"
                                        style="--m:@e.Minute"
                                        data-flow-ref="@id"
                                        title="@e.Minute' Gol: @e.Player">

                                    <span class="flow-marker__dot">
                                        <svg class="i-ball" aria-hidden="true">
                                            <use href="#i-ball" />
                                        </svg>
                                    </span>

                                </button>
                            }
                            else if (e.Type == "sub")
                            {
                                <button type="button"
                                        class="flow-marker flow-marker--@side flow-marker--sub"
                                        style="--m:@e.Minute"
                                        data-flow-ref="@id"
                                        title="@e.Minute' Değişiklik: @e.Player">

                                    <span class="flow-marker__dot"></span>

                                </button>
                            }
                            else
                            {
                                bool red = e.CardType?.ToLower().Contains("red") == true ||
                                e.CardType?.ToLower().Contains("kırmızı") == true;

                                <button type="button"
                                        class="flow-marker flow-marker--@side flow-marker--card"
                                        style="--m:@e.Minute"
                                        data-flow-ref="@id"
                                        title="@e.Minute' Kart: @e.Player">

                                    <span class="flow-marker__dot">
                                        <span class="i-card @(red ? "i-card--red" : "i-card--yellow")"></span>
                                    </span>

                                </button>
                            }
                        }

                    </div>

                </div>

            </section>

        </header>

        <div class="match-body">

            <div class="row g-4">

                <!-- SOL KOLON -->
                <div class="col-lg-8">

                    <!-- Maç olayları -->
                    <section class="panel"
                             aria-labelledby="timeline-title">

                        <div class="panel__head">

                            <h2 class="panel__title"
                                id="timeline-title">
                                Maç olayları
                            </h2>

                            <div class="event-filter"
                                 role="group"
                                 aria-label="Olay türüne göre filtrele">

                                <button type="button"
                                        class="chip"
                                        data-event-filter="all"
                                        aria-pressed="true">
                                    Tümü
                                </button>

                                <button type="button"
                                        class="chip"
                                        data-event-filter="goal"
                                        aria-pressed="false">
                                    Goller
                                </button>

                                <button type="button"
                                        class="chip"
                                        data-event-filter="card"
                                        aria-pressed="false">
                                    Kartlar
                                </button>

                                <button type="button"
                                        class="chip"
                                        data-event-filter="sub"
                                        aria-pressed="false">
                                    Değişiklikler
                                </button>

                            </div>

                        </div>

                        <div class="timeline-legend"
                             aria-hidden="true">

                            <span>
                                @if (!string.IsNullOrWhiteSpace(Model.HomeTeam?.LogoUrl))
                                {
                                    <img class="team-crest team-crest--xs"
                                         src="@Url.Content(Model.HomeTeam.LogoUrl)"
                                         alt="" />
                                }
                                @Model.HomeTeam?.Name
                            </span>

                            <span></span>

                            <span>
                                @Model.AwayTeam?.Name

                                @if (!string.IsNullOrWhiteSpace(Model.AwayTeam?.LogoUrl))
                                {
                                    <img class="team-crest team-crest--xs"
                                         src="@Url.Content(Model.AwayTeam.LogoUrl)"
                                         alt="" />
                                }
                            </span>

                        </div>

                        <ol class="timeline">

                            <li class="event event--period">
                                <span class="period-mark">
                                    Başlama düdüğü
                                </span>
                            </li>

                            @{
                                int runningHome = 0;
                                int runningAway = 0;
                                bool halftimeInserted = false;
                            }

                            @foreach (var e in allEvents)
                            {
                                if (!halftimeInserted && e.Minute > 45)
                                {
                                    halftimeInserted = true;

                                    <li class="event event--period">
                                        <span class="period-mark">
                                            Devre arası
                                            <strong>@firstHalfHome-@firstHalfAway</strong>
                                        </span>
                                    </li>
                                }

                                var side = e.TeamId == Model.HomeTeam?.Id ? "home" : "away";
                                var id = $"ev-{e.Type}-{e.Minute}-{e.TeamId}";

                                if (e.Type == "goal")
                                {
                                    if (side == "home")
                                        runningHome++;
                                    else
                                        runningAway++;

                                    <li class="event event--@side event--goal"
                                        id="@id"
                                        data-type="goal">

                                        <span class="event__minute">
                                            @e.Minute'
                                        </span>

                                        <div class="event-card">

                                            <span class="event-card__icon">
                                                <svg class="i-ball"
                                                     aria-hidden="true">
                                                    <use href="#i-ball" />
                                                </svg>
                                            </span>

                                            <span class="event-card__body">
                                                <span class="event-card__player">
                                                    @e.Player
                                                </span>

                                                <span class="event-card__meta">
                                                    Gol
                                                </span>
                                            </span>

                                            <span class="event-score">
                                                @runningHome-@runningAway
                                            </span>

                                        </div>

                                    </li>
                                }
                                else if (e.Type == "card")
                                {
                                    bool red = e.CardType?.ToLower().Contains("red") == true ||
                                    e.CardType?.ToLower().Contains("kırmızı") == true;

                                    <li class="event event--@side @(red ? "event--red" : "event--yellow")"
                                        id="@id"
                                        data-type="card">

                                        <span class="event__minute">
                                            @e.Minute'
                                        </span>

                                        <div class="event-card">

                                            <span class="event-card__icon">
                                                <span class="i-card @(red ? "i-card--red" : "i-card--yellow")"></span>
                                            </span>

                                            <span class="event-card__body">
                                                <span class="event-card__player">
                                                    @e.Player
                                                </span>

                                                <span class="event-card__meta">
                                                    @e.CardType kart
                                                </span>
                                            </span>

                                        </div>

                                    </li>
                                }
                                else
                                {
                                    <li class="event event--@side event--sub"
                                        id="@id"
                                        data-type="sub">

                                        <span class="event__minute">
                                            @e.Minute'
                                        </span>

                                        <div class="event-card">

                                            <span class="event-card__icon">
                                                <svg width="18"
                                                     height="18"
                                                     aria-hidden="true">
                                                    <use href="#i-swap" />
                                                </svg>
                                            </span>

                                            <span class="event-card__body">
                                                <span class="event-card__player sub-in">
                                                    @e.Player
                                                </span>

                                                <span class="event-card__meta sub-out">
                                                    @e.Extra
                                                </span>
                                            </span>

                                        </div>

                                    </li>
                                }
                            }

                            @if (!halftimeInserted)
                            {
                                <li class="event event--period">
                                    <span class="period-mark">
                                        Devre arası
                                        <strong>@firstHalfHome-@firstHalfAway</strong>
                                    </span>
                                </li>
                            }

                            <li class="event event--period">
                                <span class="period-mark">
                                    Maç sonu
                                    <strong>@Model.HomeScore-@Model.AwayScore</strong>
                                </span>
                            </li>

                        </ol>

                    </section>

                    <!-- Goller -->
                    <section class="panel"
                             aria-labelledby="goals-title">

                        <div class="panel__head">
                            <h2 class="panel__title"
                                id="goals-title">
                                Goller
                            </h2>
                        </div>

                        <div class="split">

                            <div class="split__col">

                                <h3 class="split__team">

                                    @if (!string.IsNullOrWhiteSpace(Model.HomeTeam?.LogoUrl))
                                    {
                                        <img class="team-crest team-crest--xs"
                                             src="@Url.Content(Model.HomeTeam.LogoUrl)"
                                             alt="" />
                                    }

                                    @Model.HomeTeam?.Name

                                    <span class="split__count">
                                        @homeGoals.Count gol
                                    </span>

                                </h3>

                                <ul class="item-list goal-list">

                                    @if (homeGoals.Any())
                                    {
                                        @foreach (var goal in homeGoals)
                                        {
                                            <li>
                                                <span class="item-minute">
                                                    @goal.Minute'
                                                </span>

                                                <span class="item-main">
                                                    <strong>
                                                        @goal.PlayerName
                                                    </strong>
                                                </span>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="item-empty">
                                            Gol yok
                                        </li>
                                    }

                                </ul>

                            </div>

                            <div class="split__col">

                                <h3 class="split__team">

                                    @if (!string.IsNullOrWhiteSpace(Model.AwayTeam?.LogoUrl))
                                    {
                                        <img class="team-crest team-crest--xs"
                                             src="@Url.Content(Model.AwayTeam.LogoUrl)"
                                             alt="" />
                                    }

                                    @Model.AwayTeam?.Name

                                    <span class="split__count">
                                        @awayGoals.Count gol
                                    </span>

                                </h3>

                                <ul class="item-list goal-list">

                                    @if (awayGoals.Any())
                                    {
                                        @foreach (var goal in awayGoals)
                                        {
                                            <li>
                                                <span class="item-minute">
                                                    @goal.Minute'
                                                </span>

                                                <span class="item-main">
                                                    <strong>
                                                        @goal.PlayerName
                                                    </strong>
                                                </span>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="item-empty">
                                            Gol yok
                                        </li>
                                    }

                                </ul>

                            </div>

                        </div>

                    </section>

                    <!-- Kartlar -->
                    <section class="panel"
                             aria-labelledby="cards-title">

                        <div class="panel__head">
                            <h2 class="panel__title"
                                id="cards-title">
                                Kartlar
                            </h2>
                        </div>

                        <div class="split">

                            @foreach (var teamSide in new[]
                                                        {
                                                        new { Id = Model.HomeTeam?.Id, Name = Model.HomeTeam?.Name, Logo = Model.HomeTeam?.LogoUrl },
                                                        new { Id = Model.AwayTeam?.Id, Name = Model.AwayTeam?.Name, Logo = Model.AwayTeam?.LogoUrl }
                                                        })
                            {
                                var teamCards = cards
                                .Where(x => x.TeamId == teamSide.Id)
                                .ToList();

                                <div class="split__col">

                                    <h3 class="split__team">

                                        @if (!string.IsNullOrWhiteSpace(teamSide.Logo))
                                        {
                                            <img class="team-crest team-crest--xs"
                                                 src="@Url.Content(teamSide.Logo)"
                                                 alt="" />
                                        }

                                        @teamSide.Name

                                        <span class="split__count">
                                            @teamCards.Count kart
                                        </span>

                                    </h3>

                                    <ul class="item-list">

                                        @if (teamCards.Any())
                                        {
                                            @foreach (var card in teamCards)
                                            {
                                                bool red =
                                                card.CardType?.ToLower().Contains("red") == true ||
                                                card.CardType?.ToLower().Contains("kırmızı") == true;

                                                <li>

                                                    <span class="item-minute">
                                                        @card.Minute'
                                                    </span>

                                                    <span class="item-main">
                                                        <strong>
                                                            @card.PlayerName
                                                        </strong>
                                                    </span>

                                                    <span class="card-tag">
                                                        <span class="i-card @(red ? "i-card--red" : "i-card--yellow")"></span>
                                                        @(red ? "Kırmızı" : "Sarı")
                                                    </span>

                                                </li>
                                            }
                                        }
                                        else
                                        {
                                            <li class="item-empty">
                                                Kart yok
                                            </li>
                                        }

                                    </ul>

                                </div>
                            }

                        </div>

                    </section>

                    <!-- Oyuncu değişiklikleri -->
                    <section class="panel"
                             aria-labelledby="subs-title">

                        <div class="panel__head">
                            <h2 class="panel__title"
                                id="subs-title">
                                Oyuncu değişiklikleri
                            </h2>
                        </div>

                        <div class="split">

                            @foreach (var teamSide in new[]
                                                        {
                                                        new { Id = Model.HomeTeam?.Id, Name = Model.HomeTeam?.Name, Logo = Model.HomeTeam?.LogoUrl },
                                                        new { Id = Model.AwayTeam?.Id, Name = Model.AwayTeam?.Name, Logo = Model.AwayTeam?.LogoUrl }
                                                        })
                            {
                                var teamSubs = substitutions
                                .Where(x => x.TeamId == teamSide.Id)
                                .ToList();

                                <div class="split__col">

                                    <h3 class="split__team">

                                        @if (!string.IsNullOrWhiteSpace(teamSide.Logo))
                                        {
                                            <img class="team-crest team-crest--xs"
                                                 src="@Url.Content(teamSide.Logo)"
                                                 alt="" />
                                        }

                                        @teamSide.Name

                                        <span class="split__count">
                                            @teamSubs.Count değişiklik
                                        </span>

                                    </h3>

                                    <ul class="item-list">

                                        @if (teamSubs.Any())
                                        {
                                            @foreach (var sub in teamSubs)
                                            {
                                                <li>

                                                    <span class="item-minute">
                                                        @sub.Minute'
                                                    </span>

                                                    <span class="item-main">

                                                        <strong class="sub-in">
                                                            @sub.PlayerIn
                                                        </strong>

                                                        <small class="sub-out">
                                                            @sub.PlayerOut
                                                        </small>

                                                    </span>

                                                </li>
                                            }
                                        }
                                        else
                                        {
                                            <li class="item-empty">
                                                Değişiklik yok
                                            </li>
                                        }

                                    </ul>

                                </div>
                            }

                        </div>

                    </section>

                </div>

                <!-- SAĞ KOLON -->
                <aside class="col-lg-4 side-col"
                       aria-label="Maç özeti">

                    <!-- Devre skorları -->
                    <div class="period-cards">

                        <article class="period-card">

                            <p class="period-card__label">
                                İlk yarı
                            </p>

                            <p class="period-card__score">
                                @firstHalfHome-@firstHalfAway
                            </p>

                            <p class="period-card__note">
                                Devre sonucu
                            </p>

                        </article>

                        <article class="period-card">

                            <p class="period-card__label">
                                İkinci yarı
                            </p>

                            <p class="period-card__score">
                                @secondHalfHome-@secondHalfAway
                            </p>

                            <p class="period-card__note">
                                İkinci yarı
                            </p>

                        </article>

                        <article class="period-card period-card--final">

                            <p class="period-card__label">
                                Sonuç
                            </p>

                            <p class="period-card__score">
                                @Model.HomeScore-@Model.AwayScore
                            </p>

                            <p class="period-card__note">
                                @ResultNote()
                            </p>

                        </article>

                    </div>

                    <!-- Maç bilgileri -->
                    <section class="panel"
                             aria-labelledby="info-title">

                        <div class="panel__head">
                            <h2 class="panel__title"
                                id="info-title">
                                Maç bilgileri
                            </h2>
                        </div>

                        <dl class="info-list">

                            <div>
                                <dt>Lig</dt>
                                <dd>Serie A</dd>
                            </div>

                            <div>
                                <dt>Sezon</dt>
                                <dd>2026/27</dd>
                            </div>

                            <div>
                                <dt>Hafta</dt>
                                <dd>@Model.Week</dd>
                            </div>

                            <div>
                                <dt>Stadyum</dt>
                                <dd>@Model.Stadium</dd>
                            </div>

                            <div>
                                <dt>Tarih</dt>
                                <dd>
                                    @Model.MatchDate.ToString("d MMMM yyyy", tr)
                                </dd>
                            </div>

                            <div>
                                <dt>Saat</dt>
                                <dd>
                                    @Model.MatchDate.ToString("HH:mm")
                                </dd>
                            </div>

                        </dl>

                    </section>

                </aside>

            </div>

        </div>

        <p class="page-note">
            Veriler SerieA API üzerinden alınmaktadır.
        </p>

    </main>

</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const root = document.querySelector('[data-match]');
            if (!root) return;

            const chips = Array.from(root.querySelectorAll('[data-event-filter]'));
            const events = Array.from(root.querySelectorAll('.event[data-type]'));
            const markers = Array.from(root.querySelectorAll('[data-flow-ref]'));

            const reduceMotion =
                window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function setFilter(type) {
                chips.forEach((chip) => {
                    chip.setAttribute(
                        'aria-pressed',
                        String(chip.dataset.eventFilter === type)
                    );
                });

                events.forEach((event) => {
                    event.hidden =
                        type !== 'all' &&
                        event.dataset.type !== type;
                });
            }

            chips.forEach((chip) => {
                chip.addEventListener('click', () => {
                    setFilter(chip.dataset.eventFilter);
                });
            });

            markers.forEach((marker) => {
                const target =
                    document.getElementById(marker.dataset.flowRef);

                if (!target) return;

                marker.addEventListener('click', () => {
                    if (target.hidden) {
                        setFilter('all');
                    }

                    target.scrollIntoView({
                        block: 'center',
                        behavior: reduceMotion ? 'auto' : 'smooth'
                    });

                    target.classList.remove('is-flash');
                    void target.offsetWidth;
                    target.classList.add('is-flash');

                    setTimeout(() => {
                        target.classList.remove('is-flash');
                    }, 1600);
                });

                const on = () => {
                    target.classList.add('is-hover');
                    marker.classList.add('is-hover');
                };

                const off = () => {
                    target.classList.remove('is-hover');
                    marker.classList.remove('is-hover');
                };

                marker.addEventListener('mouseenter', on);
                marker.addEventListener('mouseleave', off);
                target.addEventListener('mouseenter', on);
                target.addEventListener('mouseleave', off);
            });
        })();
    </script>
}
